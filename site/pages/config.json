    {
      "id": "client-config",
      "title": "Client Config",
      "intro": "Client-side rendering and audio preferences. Stored in the same JSON file but never synced — every client owns its values independently.",
      "blocks": [
        {
          "type": "table",
          "headers": ["Key", "Type", "Default", "Range", "Description"],
          "rows": [
            ["<code class='text-bone whitespace-nowrap'>villagerSoundVolume</code>", "float", "1.0", "0.0 – 1.0", "Volume for all villager sound events (0.0 = mute, 1.0 = vanilla)."],
