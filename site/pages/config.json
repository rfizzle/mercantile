{
  "nav": "Config",
  "metaTitle": "Config — Mercantile | Villager Overhaul for Minecraft",
  "metaDescription": "Every Mercantile config option: server settings (pickup, names, trade cycling, reputation, follow mode, pathfinding, sentry pylon) and client settings, with types, defaults, and ranges.",
  "ogTitle": "Config — Mercantile",
  "ogDescription": "Every Mercantile config option with types, defaults, and ranges.",
  "title": "Configuration",
  "lede": "Every Mercantile setting, organized by section. Tune via the Mod Menu + Cloth Config GUI or by hand-editing the JSON file.",
  "width": "5xl",
  "sections": [
    {
      "id": "file-location",
      "title": "File Location &amp; Reload",
      "plainTitle": true,
      "blocks": [
        {
          "type": "code",
          "label": "The config file is generated on first launch at:",
          "code": ".minecraft/config/mercantile.json",
          "bottomGap": true
        },
        {
          "type": "code",
          "label": "Server operators can apply changes without a restart with:",
          "code": "/mercantile reload",
          "bottomGap": true
        },
        {
          "type": "prose",
          "html": [
            "Missing keys are filled with defaults and saved. Unknown keys are ignored. All numeric values are clamped on load — out-of-range hand edits are silently corrected."
          ]
        }
      ]
    },
