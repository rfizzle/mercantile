              "rows": [
                ["<code class='text-bone whitespace-nowrap'>enableVillagerPickup</code>", "boolean", "true", "—", "Master toggle for villager pickup feature."],
                ["<code class='text-bone whitespace-nowrap'>pickupXpCost</code>", "int", "5", "0+", "XP levels deducted per pickup (creative waived)."]
