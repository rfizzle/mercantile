            ["<code class='text-bone whitespace-nowrap'>enableBellRadiusVis</code>", "boolean", "true", "—", "Render the 48-block bell radius circle while holding a bell."],
            ["<code class='text-bone whitespace-nowrap'>enableInfoPanel</code>", "boolean", "true", "—", "Show the villager info side panel in the merchant screen."],
