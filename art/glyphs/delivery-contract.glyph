# mercantile — delivery contract (32×32 item sprite)
# A bone-paper sheet lit from the top-left: light-bone highlight along the top
# and left inner edges, ash core shadow along the bottom and right, and a
# dog-eared top-right corner whose underside steps down in ash behind a smoke
# crease. Four smoke script lines carry the request; the signature accent is
# the emerald wax seal, glinting bright at its upper-left and ramping through
# deep emerald to a dark rim where it presses into the paper.
size: 32

legend:
  . transparent
  K ink                        # silhouette outline
  b bone                       # paper body
  l #f5efe4                    # light bone (top/left highlight)
  a ash                        # core shadow + fold underside
  s smoke                      # script lines + fold crease
  e mercantile.emerald         # seal body
  E mercantile.emerald-bright  # seal glint
  g #2f8e55                    # seal core shadow
  d #1d4d33                    # seal rim (dark emerald, not pure black)

frame:
