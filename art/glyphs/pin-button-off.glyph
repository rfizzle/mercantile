# Mercantile — merchant-screen "trade unpinned" glyph (11x11). Hollow variant of
# pin-button: same map-pin silhouette, emerald inner rim, transparent core, so
# the pinned/unpinned states read at a glance as filled vs empty.
size: 11
kind: sprite

legend:
  . transparent
  K ink                          # #0a0a0a outline
  E mercantile.emerald           # #50c878 rim

grid:
  ...........
  ...KKKKK...
  ..KEEEEEK..
  ..KE...EK..
  ..KE...EK..
  ..KE...EK..
  ...KEEEK...
  ....KEK....
  .....K.....
  ...........
  ...........
