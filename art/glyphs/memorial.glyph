# mercantile — memorial keepsake (32×32 item sprite)
# A weathered villager skull, mirror-symmetric, lit from directly above:
# bone highlight on the dome, ramping through light-bone and ash to smoke at
# the jaw. Long villager nose slab down the center; each dark socket holds an
# emerald glint on its inner edge — the memory that lives on.
size: 32
kind: sprite
ships: src/main/resources/assets/mercantile/textures/item/memorial.png

legend:
  . transparent
  K ink                        # silhouette outline
  b bone                       # dome highlight
  l #cfc5b4                    # light bone (upper mid)
  a ash                        # midtone
  s smoke                      # core shadow
  d #3f3931                    # socket occlusion (dark bone, not pure black)
  e mercantile.emerald         # glint
  E mercantile.emerald-bright  # glint core

