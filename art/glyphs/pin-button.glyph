# Mercantile — merchant-screen "trade pinned" glyph (11x11), emerald-styled to
# match the lock/info/close button family. Filled map-pin: round head tapering
# to a point, sheen on the upper-left of the head.
size: 11
kind: sprite
ships: src/main/resources/assets/mercantile/textures/gui/sprites/pin_button.png

legend:
  . transparent
  K ink                          # #0a0a0a outline
  E mercantile.emerald           # #50c878 head
  e mercantile.emerald-bright    # #6ddb94 sheen

grid:
  ...........
  ...KKKKK...
  ..KeeEEEK..
  ..KeEEEEK..
  ..KEEEEEK..
  ..KEEEEEK..
  ...KEEEK...
  ....KEK....
  .....K.....
  ...........
  ...........
