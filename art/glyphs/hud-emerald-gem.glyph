# Mercantile — reputation HUD glyph (slot 2). A cut emerald gem, replacing the
# muddy downscaled Items.EMERALD render. Static (matches sibling HUD glyphs:
# Tribulation skull, Prosperity chest). Palette: DESIGN.md §1 emerald accents.
size: 16

legend:
  . transparent
  K ink                          # #0a0a0a outline
  E mercantile.emerald           # #50c878 body
  e mercantile.emerald-bright    # #6ddb94 top facet
  d #2c8a57                      # deeper emerald — lower-right facet shadow
  w bone                         # #e8e0d4 glint

