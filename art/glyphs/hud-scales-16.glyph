# Mercantile reputation HUD glyph (slot 2) — a standing merchant's balance
# scale, authored natively for 16px (not a downscaled master). Replaces the
# emerald-gem badge. Static, matching the sibling HUD glyphs. Palette:
# DESIGN.md §1 emerald accents + a gold pivot.
size: 16
kind: sprite
ships: art/hud-icon-16.png
ships: src/main/resources/assets/mercantile/textures/gui/sprites/reputation_badge.png

legend:
  . transparent
  K #0a0a0a                       # ink outline
  E #50c878                       # mercantile.emerald — body
  e #6ddb94                       # mercantile.emerald-bright — highlight
  d #2c8a57                       # deeper emerald — facet shadow
  s #1f6b41                       # deepest emerald — underside/base
  o #ffd700                       # gold — pivot

