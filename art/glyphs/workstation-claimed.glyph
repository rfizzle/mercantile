# Mercantile — "claimed workstation" marker (16x16). An emerald check mark
# (status = villager assigned). Mercantile emerald body, emerald-bright top edge,
# ink outline. Pairs with the white "?" unclaimed marker.
size: 16

legend:
  . transparent
  K ink                          # #0a0a0a outline
  E mercantile.emerald           # #50c878 body
  e mercantile.emerald-bright    # #6ddb94 top-edge sheen

grid:
